<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ice Cream</title>

    <link rel="stylesheet" href="./styles/styles.css" />
    <link rel="icon" type="image/png" href="./images/ice_cream.png" />
    <script src="js/ice-cream.js" defer></script>
</head>
<body>
    <main>
        <h1>Ice Cream Order Form</h1>

        <form id="ice-cream-form" action="/submit-order" method="post">
            <fieldset class="order-form">
                <legend>Personal Information</legend>
                
                <label for="name">Name:</label>
                <input type="text" id="name" name="name" placeholder="John Doe" />
                <span class="err" id="name-err">Please enter a name</span>

                <label for="email">Email:</label>
                <input type="email" id="email" name="email" placeholder="john.doe@mail.com" />
                <span class="err" id="email-err">Please enter an email</span>

            </fieldset>
            <fieldset class="order-form">
                <legend>Order Details</legend>

                <span class="err" id="flavor-err">Please select a flavor</span>
                
                <label for="flavors">Choose your flavor:</label>
                <select name="flavors" id="flavors">
                    <option value="none">-- select a flavor --</option>
                    <option value="Vanilla">Vanilla</option>
                    <option value="Chocolate">Chocolate</option>
                    <option value="Strawberry">Strawberry</option>
                    <option value="Rocky Road">Rocky Road</option>
                </select>

                <fieldset id="cone-section">
                    <span class="err" id="cone-err">Please choose a cone</span>

                    <p>Choose your cone:</p>
                    <label for="waffle-cone">
                        <input type="radio" id="waffle-cone" name="cone" value="Waffle Cone"/>
                        Waffle Cone
                    </label>
                    <label for="sugar-cone">
                        <input type="radio" id="sugar-cone" name="cone" value="Sugar Cone"/>
                        Sugar Cone
                    </label>
                    <label for="cup">
                        <input type="radio" id="cup" name="cone" value="Cup"/>
                        Cup
                    </label>
                </fieldset>

                <fieldset id="toppings-section">
                    <p>Toppings:</p>
                    <label for="sprinkles">
                        <input type="checkbox" id="sprinkles" name="toppings[]" value="Sprinkles"/>
                        Sprinkles
                    </label>
                    <label for="nuts">
                        <input type="checkbox" id="nuts" name="toppings[]" value="Nuts"/>
                        Nuts
                    </label>
                    <label for="cherry">
                        <input type="checkbox" id="cherry" name="toppings[]" value="Cherry"/>
                        Cherry
                    </label>
                    <label for="whipped-cream">
                        <input type="checkbox" id="whipped-cream" name="toppings[]" value="Whipped Cream"/>
                        Whipped Cream
                    </label>
                </fieldset>

                <label for="comments" id="comments-label">Additional Comments
                    <textarea id="comments" ></textarea>
                </label>
            </fieldset>

            <button type="submit" id="order-button">Submit Order</button>
        </form>
    </main>
</body>
</html>